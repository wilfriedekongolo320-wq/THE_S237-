FROM node:20-alpine AS builder
WORKDIR /app
COPY nexus-web/package.json nexus-web/tsconfig.json ./
RUN npm install
COPY nexus-web/server ./server
COPY nexus-web/frontend/package.json nexus-web/frontend/tsconfig.json nexus-web/frontend/vite.config.ts nexus-web/frontend/tailwind.config.ts ./frontend/
COPY nexus-web/frontend/index.html ./frontend/index.html
COPY nexus-web/frontend/postcss.config.js ./frontend/postcss.config.js
COPY nexus-web/frontend/src ./frontend/src
RUN npm run build

FROM node:20-alpine
WORKDIR /app
RUN apk add --no-cache sqlite curl
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/public ./public
EXPOSE 2087
CMD ["node", "dist/server/index.js"]
