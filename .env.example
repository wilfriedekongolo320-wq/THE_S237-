# ═══════════════════════════════════════════════════════════════
# KATASHIE VPN — Variables d'environnement
# 1. Copiez ce fichier : cp .env.example .env
# 2. Remplissez toutes les valeurs marquées "⚠️  À CHANGER"
# ═══════════════════════════════════════════════════════════════

# ─── Admin principal ───────────────────────────────────────────
# ⚠️  À CHANGER : votre nom d'utilisateur admin
NEXUS_ADMIN_USER=admin

# ⚠️  À CHANGER : mot de passe fort (min 12 caractères)
NEXUS_ADMIN_PASS=ChangezMoiMaintenant2024!

# ─── Sécurité JWT ──────────────────────────────────────────────
# ⚠️  À CHANGER : générez avec : openssl rand -hex 32
NEXUS_JWT_SECRET=CHANGEZ_MOI_avec_openssl_rand_hex_32

# ─── Port du panneau ───────────────────────────────────────────
NEXUS_PORT=2087

# ─── Répertoire de données ─────────────────────────────────────
KATASHIE_DB_DIR=/etc/katashie-web

# ─── Notifications Telegram ────────────────────────────────────
# ⚠️  À CHANGER : obtenez votre token via @BotFather sur Telegram
TELEGRAM_BOT_TOKEN=
# ⚠️  À CHANGER : votre Chat ID Telegram (ex: 123456789)
TELEGRAM_ADMIN_CHAT=

# ─── Paiement Campay Mobile Money (Orange/MTN Cameroun) ────────
# Créez un compte développeur sur https://campay.net
# ⚠️  À CHANGER : vos identifiants API Campay
CAMPAY_APP_USERNAME=
CAMPAY_APP_PASSWORD=
# ⚠️  À CHANGER : votre domaine HTTPS
CAMPAY_REDIRECT_URL=https://VOTRE_DOMAINE.COM/payment/success

# ─── Backup S3/Backblaze B2 (optionnel) ────────────────────────
# ⚠️  À CHANGER si vous activez les sauvegardes automatiques
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_REGION=us-west-004
